# Cria uma base de dados Redis gratuita em https://console.upstash.com
# (Upstash é o Redis "sem servidor" recomendado pela própria Vercel)
# e copia estes dois valores do painel dela.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cria uma conta gratuita em https://resend.com (100 e-mails/dia grátis)
# para receberes uma notificação por e-mail sempre que chega um pedido.
RESEND_API_KEY=
# Opcional — só depois de verificares o teu domínio no Resend. Até lá,
# deixa em branco que usa o remetente de testes onboarding@resend.dev.
RESEND_FROM_EMAIL=
